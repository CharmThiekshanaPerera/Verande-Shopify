<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@0,300;0,400&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root{--ivory:{{ settings.color_bg }};--ink:{{ settings.color_text }};--clay:{{ settings.color_accent }};
      --stone:{{ settings.color_muted }};--bone:{{ settings.color_bg_alt }};--bg:var(--ivory);--fg:var(--ink)}
    .pw{min-height:100svh;display:grid;place-items:center;text-align:center;padding:var(--gut)}
    .pw__mark{font-family:var(--f-display);font-weight:300;text-transform:uppercase;
      font-size:clamp(38px,9vw,110px);letter-spacing:.28em;padding-left:.28em;line-height:1;margin-bottom:.3em}
  </style>
</head>
<body>
  <div class="pw">{{ content_for_layout }}</div>
</body>
</html>
