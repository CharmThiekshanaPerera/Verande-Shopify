{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.count
-%}
<section class="sec">
  {% render 'section-head',
     num: section.settings.number,
     title: section.settings.heading,
     link_url: coll.url,
     link_text: section.settings.link_text %}

  <div class="rail"{% if section.settings.auto_scroll %} data-rail-auto{% endif %} data-rail>
    {%- if coll.products.size > 0 -%}
      {%- for product in coll.products limit: limit -%}
        {%- assign tone = forloop.index0 | modulo: 6 | plus: 1 -%}
        {%- assign delay = forloop.index0 | times: 45 -%}
        {% render 'product-card', product: product, tone: tone, delay: delay, hide_price: true %}
      {%- endfor -%}
    {%- else -%}
      {%- assign names = section.settings.placeholder_names | split: ',' -%}
      {%- for name in names limit: limit -%}
        {%- assign tone = forloop.index0 | modulo: 6 | plus: 1 -%}
        <article class="card" data-rv="{{ forloop.index0 | times: 45 }}">
          <div class="card__media"><div class="ph ph-{{ tone }}" data-ph="{{ name | strip | escape }}"></div></div>
          <div class="card__body">
            <h3 class="card__name">{{ name | strip }}</h3>
          </div>
          <div class="card__sizes"><span>(S)</span><span>(M)</span><span>(L)</span></div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="rail__hint">
    {%- if section.settings.auto_scroll -%}
      <span class="mono-sm brk">{{ 'general.click' | t }}</span>
    {%- else -%}
      <span class="mono-sm brk">{{ 'general.drag' | t }} &nbsp;·&nbsp; {{ 'general.click' | t }}</span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "02." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Pieces to show", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "auto_scroll", "label": "Auto-scroll right to left", "default": true,
      "info": "The rail slides continuously; visitors can still click a piece, or drag to pause and browse." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See all" },
    { "type": "textarea", "id": "placeholder_names", "label": "Placeholder names",
      "default": "Anouk Linen Dress, Serai Shirt, Mara Wide Trouser, Veranda Silk Slip, Ostra Wrap Skirt, Alma Camisole, Rosa Linen Coat, Ceylon Two-Piece",
      "info": "Comma separated. Shown only until you pick a collection with products in it." }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
