{%- liquid
  assign p = product
  assign single = false
  if p.options.size == 1
    assign single = true
  endif
-%}
<div class="pdp" data-pdp>
  <div class="pdp__gallery">
    {%- if p.media.size > 1 -%}
      {%- comment -%} Small preview thumbnails (added) — quick-jump to each photo without scrolling the whole gallery. {%- endcomment -%}
      <div class="pdp__thumbs" role="list" aria-label="Photo previews">
        {%- for m in p.media -%}
          <a href="#pdp-shot-{{ forloop.index }}" class="pdp__thumb{% if forloop.first %} is-active{% endif %}" aria-label="View photo {{ forloop.index }} of {{ p.media.size }}">
            <img src="{{ m.preview_image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if p.media.size > 0 -%}
      {%- for m in p.media -%}
        <div class="pdp__shot" id="pdp-shot-{{ forloop.index }}">
          <img src="{{ m.preview_image | image_url: width: 1400 }}"
               srcset="{{ m.preview_image | image_url: width: 600 }} 600w, {{ m.preview_image | image_url: width: 1000 }} 1000w, {{ m.preview_image | image_url: width: 1500 }} 1500w"
               sizes="(max-width:880px) 100vw, 55vw"
               alt="{{ m.alt | escape }}" width="{{ m.preview_image.width }}" height="{{ m.preview_image.height }}"
               loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..2) -%}
        <div class="pdp__shot"><div class="ph ph-{{ forloop.index }}" data-ph="{{ p.title | escape }}"></div></div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="pdp__info">
    <div class="pdp__crumb mono-sm">
      <a href="{{ routes.root_url }}">Verande</a> —
      {%- if collection %} <a href="{{ collection.url }}">{{ collection.title }}</a>{% else %} <a href="{{ routes.all_products_collection_url }}">Shop</a>{% endif -%}
    </div>

    <h1 class="pdp__t">{{ p.title }}</h1>
    <span class="pdp__price" data-pdp-price>
      {%- if p.compare_at_price > p.price -%}<s>{% render 'price', price: p.compare_at_price %}</s>{%- endif -%}
      {% render 'price', price: p.price %}
    </span>

    {%- if p.available -%}
      {% form 'product', p %}
        {%- if single -%}
          <div class="pdp__optrow">
            <span class="pdp__lbl">{{ p.options.first }}</span>
            {%- if p.options.first == 'Size' -%}
              <button type="button" class="pdp__size-guide mono-sm" data-size-guide-open>Size guide</button>
            {%- endif -%}
          </div>
          <div class="pdp__opts">
            {%- for v in p.variants -%}
              <label class="pdp__opt">
                <input type="radio" name="id" value="{{ v.id }}"
                       data-price="{{ v.price }}"
                       data-stock="{{ v.inventory_quantity }}"
                       data-tracked="{% if v.inventory_management == 'shopify' %}1{% else %}0{% endif %}"
                       {% if v.available == false %}disabled{% endif %}
                       {% if v.id == p.selected_or_first_available_variant.id %}checked{% endif %}>
                <span>{{ v.title }}</span>
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="pdp__optrow">
            <span class="pdp__lbl">Options</span>
            <button type="button" class="pdp__size-guide mono-sm" data-size-guide-open>Size guide</button>
          </div>
          <div class="pdp__opts" style="width:100%">
            <select name="id" class="pdp__select" style="width:100%;padding:.8em 0;background:none;border:0;border-bottom:1px solid var(--ink);font-family:var(--f-mono);text-transform:uppercase;letter-spacing:.11em;font-size:10.5px">
              {%- for v in p.variants -%}
                <option value="{{ v.id }}" data-price="{{ v.price }}"
                  data-stock="{{ v.inventory_quantity }}"
                  data-tracked="{% if v.inventory_management == 'shopify' %}1{% else %}0{% endif %}"
                  {% unless v.available %}disabled{% endunless %}
                  {% if v.id == p.selected_or_first_available_variant.id %}selected{% endif %}>
                  {{ v.title }}{% unless v.available %} — {{ 'products.sold_out' | t }}{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        <button type="submit" class="btn btn--block">{{ 'products.add_to_bag' | t }}</button>
      {% endform %}
      {%- comment -%} Live low-stock note (added) — filled in and shown/hidden by theme.js as the shopper picks a size. {%- endcomment -%}
      <p class="pdp__stock mono-sm" data-pdp-stock hidden></p>
      <ul class="pdp__secure mono-sm" aria-label="Secure checkout">
        <li>🔒 Secure encrypted checkout</li>
        <li>🌍 Shipped worldwide from Colombo</li>
      </ul>
    {%- else -%}
      <button class="btn btn--block" disabled style="opacity:.4;cursor:not-allowed">{{ 'products.sold_out' | t }}</button>
      <p class="mono-sm muted" style="margin-top:1.2em">{{ 'products.sold_out_note' | t }}</p>
    {%- endif -%}

    {%- if p.description != blank -%}
      <div class="pdp__desc rte">{{ p.description }}</div>
    {%- endif -%}

    {%- liquid
      assign has_facts = false
      if p.metafields.custom.fabric_composition != blank or p.metafields.custom.fabric_colors != blank or p.metafields.custom.lining_info != blank or p.metafields.custom.back_design != blank or p.metafields.custom.model_size != blank
        assign has_facts = true
      endif
    -%}
    {%- if has_facts -%}
      <dl class="pdp__facts mono-sm">
        {%- if p.metafields.custom.fabric_composition != blank -%}
          <dt>Fabric</dt><dd>{{ p.metafields.custom.fabric_composition.value }}</dd>
        {%- endif -%}
        {%- if p.metafields.custom.fabric_colors != blank -%}
          <dt>Colour</dt><dd>{{ p.metafields.custom.fabric_colors.value }}</dd>
        {%- endif -%}
        {%- if p.metafields.custom.lining_info != blank -%}
          <dt>Lining</dt><dd>{{ p.metafields.custom.lining_info.value }}</dd>
        {%- endif -%}
        {%- if p.metafields.custom.back_design != blank -%}
          <dt>Back</dt><dd>{{ p.metafields.custom.back_design.value }}</dd>
        {%- endif -%}
        {%- if p.metafields.custom.model_size != blank -%}
          <dt>Model is wearing</dt><dd>{{ p.metafields.custom.model_size.value }}</dd>
        {%- endif -%}
      </dl>
    {%- endif -%}

    <div class="acc">
      {%- for block in section.blocks -%}
        {%- if block.settings.body != blank -%}
          <details class="acc__i" {{ block.shopify_attributes }}>
            <summary class="acc__b">{{ block.settings.heading }}</summary>
            <div class="acc__c rte">{{ block.settings.body }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% render 'size-guide-modal' %}

{%- assign rel = collections[p.collections.first.handle].products | default: collections.all.products -%}
{%- if rel.size > 1 -%}
<section class="sec">
  {% render 'section-head', num: '—', title: 'You may also like' %}
  <div class="rail" data-rail>
    {%- assign n = 0 -%}
    {%- for item in rel limit: 10 -%}
      {%- unless item.id == p.id -%}
        {%- assign tone = n | modulo: 6 | plus: 1 -%}
        {% render 'product-card', product: item, tone: tone, delay: 0 %}
        {%- assign n = n | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

<script type="application/json" data-pdp-json>{ "style": "{{ settings.price_style }}", "iso": "{{ cart.currency.iso_code }}" }</script>

{% schema %}
{
  "name": "Product",
  "blocks": [
    { "type": "detail", "name": "Detail panel", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
      { "type": "richtext", "id": "body", "label": "Body" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "detail", "settings": { "heading": "Fabric & care",
        "body": "<p>Wash cold, line dry in shade, warm iron while slightly damp. Linen is meant to crease.</p>" } },
      { "type": "detail", "settings": { "heading": "Size & fit",
        "body": "<p>Cut generously. If you are between sizes, take the smaller one.</p>" } },
      { "type": "detail", "settings": { "heading": "Shipping",
        "body": "<p>Shipped worldwide from Colombo — Europe, the Americas, Australia and the Middle East. Delivery time is shown at checkout once you enter your address.</p><p>All sales are final — we don't offer exchanges or returns, so please check sizing and details carefully before ordering.</p>" } }
    ]
  }
}
{% endschema %}
