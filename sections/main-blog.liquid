<div class="page-head"><h1 class="page-head__t">{{ blog.title }}</h1></div>
{%- paginate blog.articles by 12 -%}
  <div class="grid">
    {%- for a in blog.articles -%}
      {%- assign tone = forloop.index0 | modulo: 6 | plus: 1 -%}
      <article class="card card--grid" data-rv="0">
        <a href="{{ a.url }}"><div class="card__media">
          {% render 'media', image: a.image, tone: tone, label: a.title, sizes: '25vw' %}
        </div></a>
        <div class="card__body">
          <h3 class="card__name"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          <span class="card__price muted">{{ a.published_at | date: '%d.%m.%y' }}</span>
        </div>
      </article>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <nav class="pager">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="lnk">Prev</a>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="lnk">Next</a>{%- endif -%}
    </nav>
  {%- endif -%}
{%- endpaginate -%}
{% schema %}{ "name": "Blog" }{% endschema %}
