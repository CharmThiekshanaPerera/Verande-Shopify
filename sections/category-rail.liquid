<section class="sec">
  {% render 'section-head',
     num: section.settings.number,
     title: section.settings.heading,
     link_url: routes.collections_url,
     link_text: section.settings.link_text %}

  <div class="rail" data-rail>
    {%- for block in section.blocks -%}
      {%- assign coll = collections[block.settings.collection] -%}
      {%- assign tone = forloop.index0 | modulo: 6 | plus: 1 -%}
      {%- assign cat_url = coll.url | default: '#' -%}
      {%- if block.settings.tag != blank and coll != blank -%}
        {%- assign tag_handle = block.settings.tag | handle -%}
        {%- assign cat_url = coll.url | append: '/' | append: tag_handle -%}
      {%- endif -%}
      <a class="cat" href="{{ cat_url }}" data-rv="{{ forloop.index0 | times: 45 }}" {{ block.shopify_attributes }}>
        <div class="cat__media">
          {%- if block.settings.image != blank -%}
            {% render 'media', image: block.settings.image, tone: tone, label: '', sizes: '(max-width:700px) 62vw, 25vw' %}
          {%- elsif coll.featured_image != blank -%}
            {% render 'media', image: coll.featured_image, tone: tone, label: '', sizes: '(max-width:700px) 62vw, 25vw' %}
          {%- else -%}
            <div class="ph ph-{{ tone }}" data-ph=""></div>
          {%- endif -%}
          <span class="cat__label">{{ block.settings.title | default: coll.title }}</span>
          {%- if block.settings.count_override != blank -%}
            <span class="cat__count brk">{{ block.settings.count_override }}</span>
          {%- elsif coll != blank -%}
            <span class="cat__count brk">{{ coll.all_products_count }}</span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>

  <div class="rail__hint">
    <span class="mono-sm brk">{{ 'general.drag' | t }} &nbsp;·&nbsp; {{ 'general.click' | t }}</span>
  </div>
</section>

{% schema %}
{
  "name": "Category rail",
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "04." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Categories" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See all" }
  ],
  "blocks": [
    { "type": "cat", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Label override" },
      { "type": "text", "id": "tag", "label": "Filter by tag", "info": "Optional. Links to this collection filtered to products with this tag, e.g. linen or silk, instead of the whole collection." },
      { "type": "text", "id": "count_override", "label": "Count override", "info": "Optional. Shown instead of the collection's total count — useful when filtering by tag." },
      { "type": "image_picker", "id": "image", "label": "Image override" } ] }
  ],
  "presets": [{
    "name": "Category rail",
    "blocks": [
      { "type": "cat", "settings": { "title": "New in" } },
      { "type": "cat", "settings": { "title": "Dresses" } },
      { "type": "cat", "settings": { "title": "Shirts" } },
      { "type": "cat", "settings": { "title": "Trousers" } },
      { "type": "cat", "settings": { "title": "Skirts" } },
      { "type": "cat", "settings": { "title": "Silk" } },
      { "type": "cat", "settings": { "title": "Sets" } },
      { "type": "cat", "settings": { "title": "Outerwear" } }
    ]
  }]
}
{% endschema %}
