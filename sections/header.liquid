<header class="hdr{% unless template.name == 'index' %} is-solid{% endunless %}" data-header>
  <a href="{{ routes.root_url }}" class="hdr__mark">
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}"
           style="height:{{ section.settings.logo_height }}px;width:auto">
    {%- else -%}
      {{ section.settings.wordmark | default: shop.name }}
    {%- endif -%}
  </a>

  <nav class="hdr__nav">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="hdr__util">
    <button class="hdr__burger" data-burger aria-expanded="false">{{ 'general.menu' | t }}</button>
    <a href="{{ routes.search_url }}" class="u-hide-sm">{{ 'general.search' | t }}</a>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="u-hide-sm">{{ 'general.account' | t }}</a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}">{{ 'general.bag' | t }}&nbsp;({{ cart.item_count }})</a>
  </div>
</header>

<div class="hdr-menu" data-menu hidden>
  <nav class="hdr-menu__nav">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>
  <div class="hdr-menu__base">
    <a href="{{ routes.search_url }}" class="mono">{{ 'general.search' | t }}</a>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="mono">{{ 'general.account' | t }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Verande",
      "info": "Used when no logo image is set." },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 12, "max": 60, "step": 2, "unit": "px", "default": 20 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
