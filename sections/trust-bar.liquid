<section class="trust">
  <div class="trust__grid">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        <span class="trust__icon">{{ block.settings.glyph }}</span>
        <h4 class="trust__h">{{ block.settings.heading }}</h4>
        <p class="trust__p mono-sm">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "settings": [],
  "blocks": [
    {
      "type": "item", "name": "Item", "limit": 6,
      "settings": [
        { "type": "text", "id": "glyph", "label": "Glyph", "default": "✦" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Hand-painted" },
        { "type": "text", "id": "text", "label": "Text", "default": "Small batch, cut in Colombo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "glyph": "✦", "heading": "Hand-painted", "text": "Small batch, cut in Colombo" } },
        { "type": "item", "settings": { "glyph": "⊕", "heading": "Worldwide shipping", "text": "Europe, the Americas, Australia, the Middle East" } },
        { "type": "item", "settings": { "glyph": "⊘", "heading": "Secure checkout", "text": "Encrypted payment, every order" } },
        { "type": "item", "settings": { "glyph": "◉", "heading": "Made in Colombo", "text": "Sketched, painted and sewn locally" } }
      ]
    }
  ]
}
{% endschema %}
