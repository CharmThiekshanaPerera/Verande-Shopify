<footer class="ftr">
  <div class="ftr__grid">
    <div>
      <a href="/" class="ftr__mark" style="display:block">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="height:38px;width:auto;display:block">
        {%- else -%}
          {{ section.settings.wordmark | default: shop.name }}
        {%- endif -%}
      </a>
      <p class="ftr__blurb mono-sm">{{ settings.footer_blurb }}</p>
      <p class="mono-sm muted" style="margin-top:16px;line-height:2">
        <a href="mailto:{{ shop.email }}">{{ shop.email }}</a><br>
        {{ section.settings.locale_note | default: 'Colombo — Worldwide' }}
      </p>
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        {%- if block.type == 'info' -%}
          <div class="mono-sm muted" style="font-size:10.5px;line-height:1.95">{{ block.settings.body | default: block.settings.heading }}</div>
        {%- else -%}
          <ul>
            {%- assign menu_handle = block.settings.menu | default: 'main-menu' -%}
            {%- assign ftr_menu = linklists[menu_handle] -%}
            {%- if ftr_menu != blank -%}
              {%- for link in ftr_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
    {%- if section.blocks.size < 2 -%}
      <div>
        <h4>Contact</h4>
        <div class="mono-sm muted" style="font-size:10.5px;line-height:1.95"><p>For order, sizing or wholesale enquiries, write to us any time — we reply within a day or two.</p></div>
      </div>
      <div>
        <h4>The Atelier</h4>
        <div class="mono-sm muted" style="font-size:10.5px;line-height:1.95"><p>Hand-painted and cut in small batches, Colombo, Sri Lanka.</p></div>
      </div>
    {%- endif -%}
  </div>
  <div class="ftr__base">
    <span class="mono-sm">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span class="mono-sm">{{ section.settings.locale_note | default: 'Colombo — Worldwide' }}</span>
    <span class="mono-sm">
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}">Instagram</a>{%- endif -%}
      {%- if settings.social_pinterest != blank -%} — <a href="{{ settings.social_pinterest }}">Pinterest</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%} — <a href="{{ settings.social_tiktok }}">TikTok</a>{%- endif -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Optional. Leave blank to show the wordmark as text instead." },
    { "type": "text", "id": "wordmark", "label": "Wordmark (used when no logo image is set)", "default": "Verande" },
    { "type": "text", "id": "locale_note", "label": "Location line", "default": "Colombo — Worldwide" }
  ],
  "blocks": [
    {
      "type": "column", "name": "Menu column", "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "info", "name": "Info column", "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "heading": "Shop" } },
      { "type": "info", "settings": { "heading": "Contact", "body": "<p>For order, sizing or wholesale enquiries, write to us any time — we reply within a day or two.</p>" } },
      { "type": "info", "settings": { "heading": "The Atelier", "body": "<p>Hand-painted and cut in small batches, Colombo, Sri Lanka.</p>" } }
    ]
  }
}
{% endschema %}
