{%- if page.handle == 'contact' -%}
  <div class="page-head">
    <h1 class="page-head__t">{{ page.title }}</h1>
  </div>
  <div class="contact-top wrap">
    <div class="contact-top__copy rte" data-rv>{{ page.content }}</div>
    <div class="contact-top__media" data-rv="90">
      <img src="https://cdn.shopify.com/s/files/1/0752/9322/9222/files/mira-04.png?v=1790598466&amp;width=1200"
           srcset="https://cdn.shopify.com/s/files/1/0752/9322/9222/files/mira-04.png?v=1790598466&amp;width=600 600w,
                   https://cdn.shopify.com/s/files/1/0752/9322/9222/files/mira-04.png?v=1790598466&amp;width=900 900w,
                   https://cdn.shopify.com/s/files/1/0752/9322/9222/files/mira-04.png?v=1790598466&amp;width=1200 1200w"
           sizes="(max-width: 820px) 100vw, 50vw"
           width="900" height="1116" loading="lazy"
           alt="Verande, Colombo — natural light and hand-painted linen">
      <span class="contact-top__cap mono-sm">STUDIO — COLOMBO</span>
    </div>
  </div>
{%- else -%}
  <div class="page-head">
    <h1 class="page-head__t">{{ page.title }}</h1>
  </div>
  <div class="wrap" style="padding-bottom:var(--sec)">
    <div class="rte">{{ page.content }}</div>
  </div>
{%- endif -%}
{% schema %}{ "name": "Page" }{% endschema %}
