<div class="marq">
  <div class="marq__track" data-marquee>
    <div class="marq__item">
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span><i>{{ section.settings.separator }}</i>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "text", "id": "separator", "label": "Separator", "default": "◆" }
  ],
  "blocks": [
    { "type": "word", "name": "Word", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "New arrivals" } ] }
  ],
  "presets": [{
    "name": "Marquee",
    "blocks": [
      { "type": "word", "settings": { "text": "New Arrivals" } },
      { "type": "word", "settings": { "text": "The Linen Edit" } },
      { "type": "word", "settings": { "text": "Silk Series" } },
      { "type": "word", "settings": { "text": "Small Batch" } },
      { "type": "word", "settings": { "text": "Atelier Colombo" } },
      { "type": "word", "settings": { "text": "Resort '26" } }
    ]
  }]
}
{% endschema %}
