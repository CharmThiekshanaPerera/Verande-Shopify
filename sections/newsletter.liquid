<section class="news">
  <h2 class="news__t" data-rv>{{ section.settings.title }}</h2>
  <p class="news__p mono" data-rv="90">{{ section.settings.sub }}</p>
  <a href="{{ section.settings.contact_url }}" class="btn" data-rv="150">{{ section.settings.contact_link_text }}</a>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "richtext", "id": "title", "label": "Heading",
      "default": "<p>Questions, <em>quietly answered</em></p>" },
    { "type": "text", "id": "sub", "label": "Sub-line", "default": "Sizing, an order, a custom piece — we read every message." },
    { "type": "text", "id": "contact_link_text", "label": "Button label", "default": "Contact us" },
    { "type": "text", "id": "contact_url", "label": "Button link", "default": "/pages/contact" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
