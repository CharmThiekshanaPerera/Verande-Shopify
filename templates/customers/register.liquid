<div class="page-head"><h1 class="page-head__t">{{ 'customer.register' | t }}</h1></div>
<div class="wrap" style="max-width:420px;margin-inline:auto;padding-bottom:var(--sec)">
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <span class="pdp__lbl">First name</span>
    <div class="news__form" style="margin-bottom:2em"><input type="text" name="customer[first_name]"></div>
    <span class="pdp__lbl">Last name</span>
    <div class="news__form" style="margin-bottom:2em"><input type="text" name="customer[last_name]"></div>
    <span class="pdp__lbl">{{ 'customer.email' | t }}</span>
    <div class="news__form" style="margin-bottom:2em"><input type="email" name="customer[email]" required></div>
    <span class="pdp__lbl">{{ 'customer.password' | t }}</span>
    <div class="news__form" style="margin-bottom:2.4em"><input type="password" name="customer[password]"></div>
    <button type="submit" class="btn btn--block">{{ 'customer.register' | t }}</button>
  {% endform %}
</div>
